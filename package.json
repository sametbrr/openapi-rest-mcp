{
  "name": "openapi-rest-mcp",
  "version": "2.3.1",
  "description": "MCP server for any OpenAPI/Swagger REST API: CRUD calls, endpoint & schema discovery, fuzzy search, and flexible auth (bearer/apiKey/basic/auto-login). .NET-friendly.",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "openapi-rest-mcp": "./bin/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node test/smoke.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "swagger",
    "rest-api",
    "api",
    "crud",
    "api-testing",
    "claude-ai",
    "cursor",
    "dotnet"
  ],
  "author": "Samet Birer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sametbrr/openapi-rest-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sametbrr/openapi-rest-mcp/issues"
  },
  "homepage": "https://github.com/sametbrr/openapi-rest-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}