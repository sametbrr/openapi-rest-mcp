{
  "environments": {
    "local": {
      "baseUrl": "https://localhost:7000/api",
      "swaggerUrl": "https://localhost:7000/swagger/v1/swagger.json"
    },
    "bearer-example": {
      "baseUrl": "https://api.example.com",
      "swaggerUrl": "https://api.example.com/swagger/v1/swagger.json",
      "auth": {
        "type": "bearer",
        "token": "${API_TOKEN}"
      }
    },
    "apikey-example": {
      "baseUrl": "https://api.example.com",
      "auth": {
        "type": "apiKey",
        "in": "header",
        "headerName": "X-Api-Key",
        "value": "${API_KEY}"
      }
    },
    "basic-example": {
      "baseUrl": "https://api.example.com",
      "auth": {
        "type": "basic",
        "username": "${API_USER}",
        "password": "${API_PASS}"
      }
    },
    "login-example": {
      "baseUrl": "https://api.example.com/api",
      "swaggerUrl": "https://api.example.com/swagger/v1/swagger.json",
      "auth": {
        "type": "login",
        "loginUrl": "https://api.example.com/api/auth/login",
        "credentials": {
          "email": "${API_USER}",
          "password": "${API_PASS}"
        },
        "tokenPath": "data.accessToken",
        "expiresInPath": "data.expiresIn",
        "headerName": "Authorization",
        "headerPrefix": "Bearer "
      }
    },
    "login-auto-example": {
      "baseUrl": "https://api.example.com/api",
      "swaggerUrl": "https://api.example.com/swagger/v1/swagger.json",
      "auth": {
        "type": "login",
        "credentials": {
          "email": "${API_USER}",
          "password": "${API_PASS}"
        }
      }
    },
    "production": {
      "baseUrl": "https://api.example.com/api",
      "swaggerUrl": "https://api.example.com/swagger/v1/swagger.json",
      "rejectUnauthorized": true,
      "auth": {
        "type": "bearer",
        "token": "${PROD_API_TOKEN}"
      }
    }
  },
  "activeEnvironment": "local",
  "timeout": 30000,
  "swaggerCacheTtl": 300,
  "maxResponseChars": 100000,
  "headers": {
    "Content-Type": "application/json",
    "Accept": "application/json"
  }
}
